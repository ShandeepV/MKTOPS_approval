# Copy this file to ".env" in this same folder and fill in real values.

# Your MongoDB connection string (same one the app has always used —
# get it from whoever manages the database, or your MongoDB Atlas account).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Any long random string — used to sign login tokens. Make one up.
JWT_SECRET=change-this-to-a-long-random-string

# Initial Super Admin credentials. Override these privately before deployment.
SUPER_ADMIN_EMAIL=superadmin@ascendion.com
SUPER_ADMIN_PASSWORD=change-this-before-deployment

# Port the backend runs on locally.
PORT=5000

# Only needed if you want request-notification emails to actually send.
# Leave blank/unset and the app still runs fine, it just logs a mail error.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# Used inside notification emails to build a clickable link back to the app.
BASE_URL=http://localhost:5173
